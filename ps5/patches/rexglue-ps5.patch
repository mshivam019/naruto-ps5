diff --git a/include/rex/filesystem/case_path.h b/include/rex/filesystem/case_path.h
new file mode 100644
index 0000000..1624b1b
--- /dev/null
+++ b/include/rex/filesystem/case_path.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <filesystem>
+#include <string_view>
+#include <system_error>
+
+namespace rex::filesystem {
+// Content names use Xbox's ASCII case-insensitive lookup. Preserve the stored
+// spelling so opening, overwriting and deleting all address the same package.
+inline std::filesystem::path ResolveCaseInsensitiveLeaf(const std::filesystem::path& path) {
+  std::error_code ec;
+  if (std::filesystem::exists(path, ec)) return path;
+  const auto wanted = path.filename().string();
+  auto equal = [](std::string_view a, std::string_view b) {
+    if (a.size() != b.size()) return false;
+    auto lower = [](unsigned char c) { return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c; };
+    for (size_t i = 0; i < a.size(); ++i)
+      if (lower(a[i]) != lower(b[i])) return false;
+    return true;
+  };
+  std::filesystem::directory_iterator it(path.parent_path(), ec), end;
+  while (!ec && it != end) {
+    if (equal(it->path().filename().string(), wanted)) return it->path();
+    it.increment(ec);
+  }
+  // Missing paths retain their requested spelling for creation/error reporting.
+  return path;
+}
+}  // namespace rex::filesystem
